# Kopieer dit bestand naar Vercel Project Settings -> Environment Variables
# (nooit .env zelf committen)

# --- GoHighLevel (CRM) ---
# Inbound webhook-URL uit GoHighLevel (Settings -> Integrations -> Inbound Webhook,
# of een "Inbound Webhook"-trigger op een workflow). Ontvangt nieuwe leads server-side.
GHL_WEBHOOK_URL=

# Gedeeld geheim dat je in de GoHighLevel-workflow meestuurt als header
# `x-ghl-secret` wanneer die terugbelt naar /api/ghl-webhook (lead_contacted,
# lead_qualified, sale_closed). Voorkomt dat iemand anders dat endpoint aanroept.
GHL_SHARED_SECRET=

# --- Stripe ---
# Secrete API-key (Developers -> API keys). Nodig voor /api/verify-payment
# en /api/stripe-webhook.
STRIPE_SECRET_KEY=

# Signing secret van de webhook-endpoint die je in Stripe aanmaakt en naar
# https://<jouw-domein>/api/stripe-webhook laat wijzen, voor events
# checkout.session.completed en checkout.session.async_payment_failed.
STRIPE_WEBHOOK_SECRET=

# --- PostHog ---
# Project API key (Project Settings -> Project API Key, begint met "phc_").
# Dit is een PUBLIC/write-only key - dezelfde waarde staat ook in de HTML
# (POSTHOG_KEY in CONFIG). Hier gebruikt voor server-side capture (leads,
# betaalbevestiging, CRM-status) zodat events niet verloren gaan als de
# bezoeker de pagina al gesloten heeft.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
