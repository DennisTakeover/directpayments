# Kopieer dit bestand naar Vercel Project Settings -> Environment Variables
# (nooit .env zelf committen)

# --- GoHighLevel (CRM) ---
# Inbound webhook-URL uit GoHighLevel (Settings -> Integrations -> Inbound Webhook,
# of een "Inbound Webhook"-trigger op een workflow). Ontvangt nieuwe leads server-side.
GHL_WEBHOOK_URL=

# Inbound webhook van workflow "PV - Betaald". Leeg = betalingen gaan niet naar GHL.
GHL_PAYMENT_WEBHOOK_URL=

# Gedeeld geheim dat je in de GoHighLevel-workflow meestuurt als header
# `x-ghl-secret` wanneer die terugbelt naar /api/ghl-webhook (lead_contacted,
# lead_qualified, sale_closed). Voorkomt dat iemand anders dat endpoint aanroept.
GHL_SHARED_SECRET=

# --- Stripe ---
# Secrete API-key (Developers -> API keys). Nodig voor /api/verify-payment
# en /api/stripe-webhook.
STRIPE_SECRET_KEY=

# Publishable key (Developers -> API keys, begint met "pk_live_"). Nodig voor de
# ingebouwde betaling op /afrekenen. Moet bij dezelfde modus (live/test) horen als
# STRIPE_SECRET_KEY. Leeg = /afrekenen stuurt door naar de Stripe Payment Link.
STRIPE_PUBLISHABLE_KEY=

# Optioneel: prijs-ID (price_...) voor /afrekenen. Leeg = product en prijs worden
# overgenomen van de bestaande Payment Link.
STRIPE_PRICE_ID=

# Signing secret van de webhook-endpoint die je in Stripe aanmaakt en naar
# https://<jouw-domein>/api/stripe-webhook laat wijzen, voor events
# checkout.session.completed en checkout.session.async_payment_failed.
STRIPE_WEBHOOK_SECRET=

# --- PostHog ---
# Project API key (Project Settings -> Project API Key, begint met "phc_").
# Dit is een PUBLIC/write-only key - dezelfde waarde staat ook in de HTML
# (POSTHOG_KEY in CONFIG). Hier gebruikt voor server-side capture (leads,
# betaalbevestiging, CRM-status) zodat events niet verloren gaan als de
# bezoeker de pagina al gesloten heeft.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# --- Meta (Facebook/Instagram) ---
# Pixel-ID (Events Manager -> Gegevensbronnen). Zet hetzelfde ID ook in
# META_PIXEL_ID in de CONFIG van index.html, start.html en bedankt.html.
META_PIXEL_ID=
# Conversions API access token (Events Manager -> pixel -> Instellingen ->
# Conversions API -> Toegangstoken genereren). Geheim: alleen hier, nooit in HTML.
META_CAPI_TOKEN=
# Optioneel, alleen tijdens testen: testcode uit Events Manager -> Testgebeurtenissen.
META_TEST_EVENT_CODE=

# Slack-melding bij elke betaling, doorbetaling, mislukte betaling en opzegging (kanaal #direct-payment).
# Make.com-webhook (scenario "PromoView – betaling naar Slack" → #direct-payment). Staat in Vercel.
SLACK_WEBHOOK_URL=

# Stripe-webhook naar /api/stripe-webhook (signing secret, begint met whsec_)
STRIPE_WEBHOOK_SECRET=

# Eigen betaalstap op v7 (/api/pay): publishable key van Stripe (pk_live_..., niet geheim)
STRIPE_PUBLISHABLE_KEY=

# Eigen onboarding (/api/onboarding): Make-webhook van het scenario
# "PromoView – onboarding vanaf de website" (zelfde vervolg als de Typeform)
MAKE_ONBOARDING_WEBHOOK_URL=

# PayPro (eigen betaalstap v7: iDEAL | Wero en Bancontact, abonnement 14 dagen €49 + btw, daarna €190 + btw p/m)
PAYPRO_API_KEY=
# Optioneel: secret van de webhook "PromoView landing" in PayPro. Leeg = wordt bij PayPro opgehaald.
PAYPRO_WEBHOOK_SECRET=

# Trello-bord testklanten (Make-scenario "PromoView – testklanten naar Trello")
MAKE_BOARD_WEBHOOK_URL=

# Koppelpagina (/koppeling): Instagram-gegevens worden versleuteld.
# KOPPEL_KEY: lange willekeurige tekst (32+ tekens), niet meer wijzigen na livegang.
# KOPPEL_TEAM_CODE: code waarmee het team de gegevens bekijkt op /intern/koppeling.
KOPPEL_KEY=
KOPPEL_TEAM_CODE=
# Slack-kanaal voor onboarding en koppeling (standaard #directpayments-onboarding)
SLACK_ONBOARDING_CHANNEL=
# Make-webhook voor de automatische AI-profielcheck na de onboarding (scenario "PromoView – profielcheck (AI)")
MAKE_PROFIELCHECK_WEBHOOK_URL=
# Gedeelde sleutel tussen Make en /api/profielcheck-pdf (header x-pv-secret), min. 24 tekens
PROFIELCHECK_SECRET=
