    },
    {
      "source": "/v4",
      "destination": "/v4.html"
    },
    {
      "source": "/v5",
      "destination": "/v5.html"
    },
    {
      "source": "/afrekenen",
      "destination": "/afrekenen.html"
    },
    {
      "source": "/v6",
      "destination": "/v6.html"
    },
    {
      "source": "/afspraak-bevestigd",
      "destination": "/bedankt-afspraak.html"
    },
    {
      "source": "/v7",
      "destination": "/v7.html"
    },
    {
      "source": "/v8",
      "destination": "/v8.html"
    },
    {
      "source": "/onboarding",
      "destination": "/onboarding.html"
