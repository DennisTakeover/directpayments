      "destination": "/intern/koppeling.html"
    },
    {
      "source": "/koppeling",
      "destination": "/koppeling.html"
    },
    {
      "source": "/onboardingv2",
      "destination": "/koppeling.html"
    },
    {
      "source": "/onboarding-v2",
      "destination": "/koppeling.html"
    },
    {
      "source": "/onboardingV2",
      "destination": "/koppeling.html"
    }
  ],
  "headers": [
    {
      "source": "/intern/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/profielcheck-pdf.js": {
      "includeFiles": "api/_fonts/**",
      "maxDuration": 30
    }
  }
}
